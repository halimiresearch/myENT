# contoh — salin ke .env.prod dan isi
POSTGRES_USER=jurnalistik
# WAJIB alfanumerik (tanpa @ : / ? # &): dirangkai mentah ke DATABASE_URL di compose.
POSTGRES_PASSWORD=ganti-dengan-aman-tanpa-simbol
POSTGRES_DB=jurnalistik

JWT_SECRET=minimal-32-karakter-acak-disini
# Wajib di prod (boot menolak bila < 32 char; harus beda dari JWT_SECRET).
FILE_HMAC_SECRET=minimal-32-karakter-acak-khusus-file
QR_HMAC_SECRET=minimal-32-karakter-acak-khusus-qr
# Wajib di prod (boot menolak bila < 32 char): enkripsi secret 2FA at-rest.
TOTP_ENC_KEY=minimal-32-karakter-acak-lainnya

API_URL=https://api.contoh.id
ADMIN_URL=https://admin.contoh.id
# Opsional: origin browser yang boleh memanggil API langsung (default kosong = hanya via BFF admin).
ALLOWED_ORIGINS=https://admin.contoh.id

STORAGE_DRIVER=r2
R2_ENDPOINT=https://xxx.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=jurnalistik

FCM_PROJECT_ID=
MEETING_TICK_MS=60000

SEED_ADMIN_NIM=admin001
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
WEB_URL=https://admin.contoh.id

NEXT_PUBLIC_TURNSTILE_SITE_KEY=isi-dari-cloudflare-dashboard
TURNSTILE_SECRET_KEY=isi-dari-cloudflare-dashboard
