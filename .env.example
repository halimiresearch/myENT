DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jurnalistik?schema=public

JWT_SECRET=change-me-min-32-chars
JWT_EXPIRES_IN=15m

# Wajib di production (min 32 char; kunci terpisah dari JWT_SECRET). Kosong = fallback JWT_SECRET hanya di non-production.
FILE_HMAC_SECRET=
QR_HMAC_SECRET=
# Enkripsi secret 2FA at-rest (wajib di production, min 32 char).
TOTP_ENC_KEY=change-me-min-32-chars-juga

# Base URL publik API (prod) untuk signed URL lokal; dev fallback ke host request.
API_PUBLIC_URL=
# Origin browser untuk CORS langsung (default kosong = tertutup, hanya via BFF).
ALLOWED_ORIGINS=

REFRESH_EXPIRES_DAYS=14

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# Retensi file privat (bulan), default kode: 12 & 6.
RETENTION_SELFIE_MONTHS=12
RETENTION_ATTACHMENT_MONTHS=6

R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

WEB_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

SEED_ADMIN_NIM=admin001
SEED_ADMIN_PASSWORD=ChangeMe12345!
SEED_ADMIN_NAME=Admin
